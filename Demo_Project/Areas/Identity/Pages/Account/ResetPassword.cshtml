@page
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model PayslipMgtSystem.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = Model.IsSetup ? "Set your password" : "Reset password";
    Layout = "_AuthLayout";
    var rules = Model.PasswordRules;
    var errors = ViewData.ModelState.Where(m => m.Key == string.Empty).SelectMany(m => m.Value!.Errors).Select(e => e.ErrorMessage).ToList();
    var passwordErrors = ViewData.ModelState["Input.Password"]?.Errors.Select(e => e.ErrorMessage).ToList() ?? new List<string>();
    var confirmError = ViewData.ModelState["Input.ConfirmPassword"]?.Errors.FirstOrDefault()?.ErrorMessage;
}

@if (Model.LinkInvalid)
{
    <span class="auth-icon auth-icon--danger" aria-hidden="true"><i class="fas fa-unlink"></i></span>
    <h2>This link has expired</h2>
    <p class="auth-lead">
        The password link is invalid, has already been used, or has expired.
        Request a new one and we'll email it to you straight away.
    </p>
    <a class="auth-btn" asp-page="./ForgotPassword"><i class="fas fa-paper-plane" aria-hidden="true"></i> Request a new link</a>
    <div class="auth-back">
        <a asp-page="./Login"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to sign in</a>
    </div>
}
else
{
    <span class="auth-icon" aria-hidden="true"><i class="fas @(Model.IsSetup ? "fa-user-check" : "fa-shield-alt")"></i></span>
    <h2>@(Model.IsSetup ? "Set your password" : "Choose a new password")</h2>
    <p class="auth-lead">
        @if (Model.IsSetup)
        {
            <text>Welcome! Create a password for <strong>@Model.AccountEmail</strong>. You'll use it with your email to sign in and view your payslips.</text>
        }
        else
        {
            <text>Create a new password for <strong>@Model.AccountEmail</strong>. Make sure it's one you don't use anywhere else.</text>
        }
    </p>

    @if (errors.Any())
    {
        <div class="auth-alert auth-alert--error" role="alert">
            <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
            <div>@errors.First()</div>
        </div>
    }

    <form method="post" novalidate data-auth-form data-password-policy>
        <input type="hidden" asp-for="Input.UserId" />
        <input type="hidden" asp-for="Input.Code" />
        <input type="hidden" asp-for="Input.Mode" />

        <div class="auth-field">
            <div class="auth-field__label-row">
                <label for="new-password">New password<span class="req" aria-hidden="true">*</span></label>
            </div>
            <div class="auth-input-wrap">
                <i class="fas fa-lock lead-icon" aria-hidden="true"></i>
                <input asp-for="Input.Password" id="new-password" type="password" value=""
                       class="auth-input auth-input--password @(passwordErrors.Any() ? "is-invalid" : "")"
                       placeholder="Create a password" autocomplete="new-password" autofocus
                       aria-describedby="new-password-error new-password-rules" aria-required="true"
                       data-required="Please enter a new password."
                       data-password-input data-min-length="@rules.RequiredLength" />
                <button type="button" class="auth-reveal" data-toggle-password="new-password" aria-label="Show password" aria-pressed="false">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <span class="auth-field__error" id="new-password-error">@string.Join(" ", passwordErrors)</span>
            <div class="strength" data-level="" aria-live="polite">
                <div class="strength__bar"><span></span></div>
                <div class="strength__meta"><span>Password strength</span><span class="strength__label"></span></div>
            </div>
        </div>

        <ul class="requirements" id="new-password-rules">
            <li class="requirements__title">Your password must contain:</li>
            <li data-rule="length"><i class="fas fa-circle" aria-hidden="true"></i> At least @rules.RequiredLength characters</li>
            @if (rules.RequireUppercase)
            {
                <li data-rule="upper"><i class="fas fa-circle" aria-hidden="true"></i> One uppercase letter</li>
            }
            @if (rules.RequireLowercase)
            {
                <li data-rule="lower"><i class="fas fa-circle" aria-hidden="true"></i> One lowercase letter</li>
            }
            @if (rules.RequireDigit)
            {
                <li data-rule="digit"><i class="fas fa-circle" aria-hidden="true"></i> One number</li>
            }
            @if (rules.RequireNonAlphanumeric)
            {
                <li data-rule="special"><i class="fas fa-circle" aria-hidden="true"></i> One special character</li>
            }
        </ul>

        <div class="auth-field">
            <div class="auth-field__label-row">
                <label for="confirm-password">Confirm password<span class="req" aria-hidden="true">*</span></label>
            </div>
            <div class="auth-input-wrap">
                <i class="fas fa-lock lead-icon" aria-hidden="true"></i>
                <input asp-for="Input.ConfirmPassword" id="confirm-password" type="password" value=""
                       class="auth-input auth-input--password @(confirmError != null ? "is-invalid" : "")"
                       placeholder="Re-enter your password" autocomplete="new-password"
                       aria-describedby="confirm-password-error confirm-password-match" aria-required="true"
                       data-required="Please confirm your new password."
                       data-match="new-password" data-match-message="The passwords do not match." />
                <button type="button" class="auth-reveal" data-toggle-password="confirm-password" aria-label="Show password" aria-pressed="false">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <span class="auth-field__error" id="confirm-password-error">@confirmError</span>
            <span class="auth-field__hint" id="confirm-password-match" aria-live="polite"></span>
        </div>

        <button type="submit" class="auth-btn" data-loading-text="Saving password…">
            <i class="fas fa-check" aria-hidden="true"></i> @(Model.IsSetup ? "Set password" : "Update password")
        </button>
    </form>

    <div class="auth-back">
        <a asp-page="./Login"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to sign in</a>
    </div>
}

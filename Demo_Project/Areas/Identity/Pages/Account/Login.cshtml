@page
@using PayslipMgtSystem.Areas.Identity.Pages.Account;
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
    var errors = ViewData.ModelState.Where(m => m.Key == string.Empty).SelectMany(m => m.Value!.Errors).Select(e => e.ErrorMessage).ToList();
    var emailError = ViewData.ModelState["Input.Email"]?.Errors.FirstOrDefault()?.ErrorMessage;
    var passwordError = ViewData.ModelState["Input.Password"]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<span class="auth-icon" aria-hidden="true"><i class="fas fa-user-lock"></i></span>
<h2>Welcome back</h2>
<p class="auth-lead">Sign in to access your HRMS account.</p>

@if (errors.Any())
{
    <div class="auth-alert auth-alert--error" role="alert">
        <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
        <div>@errors.First()</div>
    </div>
}
@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="auth-alert auth-alert--success" role="status">
        <i class="fas fa-check-circle" aria-hidden="true"></i>
        <div>@Model.StatusMessage</div>
    </div>
}

<form id="account" method="post" novalidate data-auth-form>
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

    <div class="auth-field">
        <div class="auth-field__label-row">
            <label for="login-email">Email address<span class="req" aria-hidden="true">*</span></label>
        </div>
        <div class="auth-input-wrap">
            <i class="fas fa-envelope lead-icon" aria-hidden="true"></i>
            <input asp-for="Input.Email" id="login-email" type="text" class="auth-input @(emailError != null ? "is-invalid" : "")"
                   placeholder="name@company.com" autocomplete="username" autofocus
                   aria-describedby="login-email-error" aria-required="true"
                   data-required="Please enter your email address." />
        </div>
        <span class="auth-field__error" id="login-email-error">@emailError</span>
    </div>

    <div class="auth-field">
        <div class="auth-field__label-row">
            <label for="login-password">Password<span class="req" aria-hidden="true">*</span></label>
            <a class="auth-link" asp-page="./ForgotPassword">Forgot password?</a>
        </div>
        <div class="auth-input-wrap">
            <i class="fas fa-lock lead-icon" aria-hidden="true"></i>
            <input asp-for="Input.Password" id="login-password" type="password" class="auth-input auth-input--password @(passwordError != null ? "is-invalid" : "")"
                   placeholder="Enter your password" autocomplete="current-password"
                   aria-describedby="login-password-error" aria-required="true"
                   data-required="Please enter your password." />
            <button type="button" class="auth-reveal" data-toggle-password="login-password" aria-label="Show password" aria-pressed="false">
                <i class="fas fa-eye"></i>
            </button>
        </div>
        <span class="auth-field__error" id="login-password-error">@passwordError</span>
    </div>

    <div class="auth-row">
        <label class="auth-check">
            <input asp-for="Input.RememberMe" type="checkbox" />
            Keep me signed in
        </label>
    </div>

    <button type="submit" class="auth-btn" data-loading-text="Signing in…">
        <i class="fas fa-sign-in-alt" aria-hidden="true"></i> Sign in
    </button>
</form>

<div class="auth-divider"></div>
<p class="auth-help">
    First time here? Use the link in your welcome email to set your password,
    or choose <a class="auth-link" asp-page="./ForgotPassword">Forgot password?</a> to get a new one.
</p>

@page
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model PayslipMgtSystem.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
    var errors = ViewData.ModelState.Where(m => m.Key == string.Empty).SelectMany(m => m.Value!.Errors).Select(e => e.ErrorMessage).ToList();
    var emailError = ViewData.ModelState["Input.Email"]?.Errors.FirstOrDefault()?.ErrorMessage;
}

@if (Model.EmailSent)
{
    <span class="auth-icon auth-icon--success" aria-hidden="true"><i class="fas fa-paper-plane"></i></span>
    <h2>Check your inbox</h2>
    <p class="auth-lead">
        If an account exists for <strong>@Model.Input.Email</strong>, we've sent a link to reset your password.
    </p>

    <ol class="auth-steps">
        <li>Open the email from the NITB Payslip Portal.</li>
        <li>Click <strong>Reset Password</strong>. The link is valid for 3 days.</li>
        <li>Choose a new password, then sign in.</li>
    </ol>

    <div class="auth-alert auth-alert--info" role="note">
        <i class="fas fa-info-circle" aria-hidden="true"></i>
        <div>Didn't get it? Check your spam folder, or wait a minute and try again.</div>
    </div>

    <a class="auth-btn" asp-page="./Login"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to sign in</a>
    <div class="auth-back">
        <a asp-page="./ForgotPassword"><i class="fas fa-redo" aria-hidden="true"></i> Send the link again</a>
    </div>
}
else
{
    <span class="auth-icon" aria-hidden="true"><i class="fas fa-key"></i></span>
    <h2>Forgot your password?</h2>
    <p class="auth-lead">
        Enter the email address linked to your account and we'll email you a link to reset your password.
    </p>

    @if (errors.Any())
    {
        <div class="auth-alert auth-alert--error" role="alert">
            <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
            <div>@errors.First()</div>
        </div>
    }

    <form method="post" novalidate data-auth-form>
        <div class="auth-field">
            <div class="auth-field__label-row">
                <label for="forgot-email">Email address<span class="req" aria-hidden="true">*</span></label>
            </div>
            <div class="auth-input-wrap">
                <i class="fas fa-envelope lead-icon" aria-hidden="true"></i>
                <input asp-for="Input.Email" id="forgot-email" type="email" class="auth-input @(emailError != null ? "is-invalid" : "")"
                       placeholder="name@company.com" autocomplete="email" autofocus
                       aria-describedby="forgot-email-error" aria-required="true"
                       data-required="Please enter your email address."
                       data-email="Please enter a valid email address." />
            </div>
            <span class="auth-field__error" id="forgot-email-error">@emailError</span>
        </div>

        <button type="submit" class="auth-btn" data-loading-text="Sending link…">
            <i class="fas fa-paper-plane" aria-hidden="true"></i> Send reset link
        </button>
    </form>

    <div class="auth-back">
        <a asp-page="./Login"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to sign in</a>
    </div>
}

@section Scripts {
    @if (Model.EmailSent)
    {
        <script>window.appToast.show('success', 'If the account exists, a reset link has been sent.', 'Reset link sent');</script>
    }
}

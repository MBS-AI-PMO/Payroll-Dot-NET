@page "/"
@using PayslipMgtSystem.Components
@inject AppDbContext _context
@inject UploadFileService uploadFileService
@inject IWebHostEnvironment Environment
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles = "Admin")]

<style>
    .input:hover {
        cursor: pointer;
    }

    .btn:hover .email-svg {
        fill: white;
    }

    .fixed-body {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        overflow: hidden;
    }

    .i1 {
        cursor: pointer;
    }

        .i1:hover {
            color: green;
        }

    .ml-5 {
        margin-left: 20px;
    }

    .color-odd {
        background-color: #F9F9F9;
        border-radius: 0.3rem;
        height: auto;
        align-items: center;
        word-break: break-all;
    }

    .color-even {
        margin-top: 5px;
        height: auto;
        align-items: center;
        word-break: break-all;
    }
</style>
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-4">
                    <div class="input-group input-group-sm input-group-solid" style=" background-color: #F3F6F9; border-radius: 0.28rem; width: 100%; height:40px;; margin-top:2px;">
                        <input type="search"
                               class="form-control py-0"
                               value="@searchQuery"
                               id="kt_subheader_search_form"
                               placeholder="Search..."
                               style="font-weight: bold; color: black; opacity: 1; font-size: 0.8rem; border: 0; background-color: transparent; outline: none !important; -webkit-box-shadow: none; box-shadow: none;"
                               @oninput="OnInput">
                    </div>
            </div>
            <div class="row">
                <form>
                    <div class="row mt-2" style="align-items:center">
                        <p class="text-danger">@filterMessage</p>
                        <div class="col-4">
                            <div class="form-group">
                                <select class="form-control input" @bind="selectedYear">
                                    <option value="0">Select Year</option>
                                    @foreach (var year in Enumerable.Range(DateTime.Now.Year - 10, 11))
                                    {
                                        <option value="@year">@year</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-group">
                                <select class="form-control input" @bind="selectedMonth">
                                    <option value="0">Select Month</option>
                                    <option value="1">January</option>
                                    <option value="2">February</option>
                                    <option value="3">March</option>
                                    <option value="4">April</option>
                                    <option value="5">May</option>
                                    <option value="6">June</option>
                                    <option value="7">July</option>
                                    <option value="8">August</option>
                                    <option value="9">September</option>
                                    <option value="10">October</option>
                                    <option value="11">November</option>
                                    <option value="12">December</option>

                                </select>
                            </div>
                        </div>
                        <div class="col-4">
                            <button type="button" class="btn btn-sm btn-secondary" @onclick="YearMonthFilter">Filter</button>
                        </div>
                        @if (filteredFileContent != null)
                        {
                            <p>Total Record: @totalcount </p>
                        }
                    </div>
                </form>
            </div>
        </div>
        <div class="d-flex justify-content-end mt-2">
            <div>
                <button class="btn btn-success btn-sm mb-2" style="margin-right:5px;" @onclick="DownloadTemplate">
                    Download Template
                    <svg class="ml-2" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:sketch="http://www.bohemiancoding.com/sketch/ns" width="20px" height="20px" viewBox="0 -2 30 30" version="1.1">

                        <title>download</title>
                        <desc>Created with Sketch Beta.</desc>
                        <defs>

                        </defs>
                        <g id="Page-1" stroke="none" stroke-width="1" fill="#FFFFFF" fill-rule="evenodd" sketch:type="MSPage">
                            <g id="Icon-Set" sketch:type="MSLayerGroup" transform="translate(-101.000000, -726.000000)" fill="#FFFFFF">
                                <path d="M130,726 L102,726 C101.448,726 101,726.448 101,727 L101,735 C101,735.553 101.448,736 102,736 C102.552,736 103,735.553 103,735 L103,728 L129,728 L129,735 C129,735.553 129.448,736 130,736 C130.552,736 131,735.553 131,735 L131,727 C131,726.447 130.552,726 130,726 L130,726 Z M120.267,744.3 L117,748.26 L117,734.002 C117,733.449 116.552,733 116,733 C115.448,733 115,733.449 115,734.002 L115,748.298 L111.702,744.3 C111.31,743.905 110.674,743.905 110.282,744.3 C109.89,744.693 109.89,745.332 110.282,745.726 L115.224,751.717 C115.433,751.927 115.71,752.017 115.984,752.002 C116.258,752.017 116.536,751.927 116.745,751.717 L121.687,745.726 C122.079,745.332 122.079,744.693 121.687,744.3 C121.295,743.905 120.659,743.905 120.267,744.3 L120.267,744.3 Z" id="download" sketch:type="MSShapeGroup">

                                </path>
                            </g>
                        </g>
                    </svg>
                </button>
            </div>
            <div>
                <button type="button" class="btn btn-outline-success btn-sm float-right" data-toggle="modal" data-target="#myModal" @onclick="EditData">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="20px" height="18px"><defs><linearGradient id="G7C1BuhajJQaEWHVlNUzHa" x1="6" x2="27" y1="24" y2="24" data-name="Безымянный градиент 10" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#21ad64" /><stop offset="1" stop-color="#088242" /></linearGradient></defs><path fill="#31c447" d="m41,10h-16v28h16c.55,0,1-.45,1-1V11c0-.55-.45-1-1-1Z" /><path fill="#fff" d="m32,15h7v3h-7v-3Zm0,10h7v3h-7v-3Zm0,5h7v3h-7v-3Zm0-10h7v3h-7v-3Zm-7-5h5v3h-5v-3Zm0,10h5v3h-5v-3Zm0,5h5v3h-5v-3Zm0-10h5v3h-5v-3Z" /><path fill="url(#G7C1BuhajJQaEWHVlNUzHa)" d="m27,42l-21-4V10l21-4v36Z" /><path fill="#fff" d="m19.13,31l-2.41-4.56c-.09-.17-.19-.48-.28-.94h-.04c-.05.22-.15.54-.32.98l-2.42,4.52h-3.76l4.46-7-4.08-7h3.84l2,4.2c.16.33.3.73.42,1.18h.04c.08-.27.22-.68.44-1.22l2.23-4.16h3.51l-4.2,6.94,4.32,7.06h-3.74Z" /></svg>
                    Upload
                </button>
            </div>
        </div>

        <!-- The Modal -->
        <div class="modal right fade" id="myModal">
            <div class="modal-dialog" style="width:auto">
                <div class="modal-content">

                    <!-- Modal Header -->
                    <div class="modal-header bg-success text-white">
                        <h4 class="modal-title">@(filess.Id == 0 ? "Upload Record" : "Edit Record")</h4>
                        <button type="button" class="btn close text-white" data-dismiss="modal">&times;</button>
                    </div>

                    <!-- Modal body -->
                    <div class="modal-body">
                        <EditForm Model="filess" OnValidSubmit="Add">
                            @if (filess.Id != 0)
                            {
                                <div class="row">
                                    <div class="col-6">
                                        <label>Name</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" @bind-value="filess.EmployeeName" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label>Email</label>
                                        <div class="form-group">
                                            <input type="email" class="form-control" @bind-value="filess.Email" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label>Cnic</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" @bind-value="filess.Cnic" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label>Designation</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" @bind-value="filess.ServiceCategory" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label>Joining Date</label>
                                        <div class="form-group">
                                            <input type="datetime" class="form-control" @bind-value="filess.JoiningDate" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label>Month Days</label>
                                        <div class="form-group">
                                            <input type="number" class="form-control" @bind-value="filess.MonthDays" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label>Present Days</label>
                                        <div class="form-group">
                                            <input type="number" class="form-control" @bind-value="filess.PresentDays" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label>Offered Salary</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" @bind-value="filess.OfferedSalary" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label>Arrears</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" @bind-value="filess.Arrears" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label>Allowances</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" @bind-value="filess.Allowances" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label>Advance Loan</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" @bind-value="filess.AdvancesLoan" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label>Gross Salary</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" @bind-value="filess.GrossSalary" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label>Loan Deduction</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" @bind-value="filess.AdvancesLoanDeduction" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label>EOBI</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" @bind-value="filess.EOBI" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label>Other Deduction</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" @bind-value="filess.OtherDeduction" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label>WHIT Deduction</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" @bind-value="filess.WHITDeduction" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label>Total Deduction</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" @bind-value="filess.TotalDeductions" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label>Net Amount</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" @bind-value="filess.NetAmount" />
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (filess.Id == 0)
                            {
                                <div class="form-group mt-2">
                                    <InputSelect class="form-control input" @bind-Value="filess.Year">
                                        <option value="0">Select Year</option>
                                        @foreach (var year in Enumerable.Range(DateTime.Now.Year - 10, 11))
                                        {
                                            <option value="@year">@year</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="form-group mt-2">
                                    <InputSelect class="form-control input" @bind-Value="filess.Month">
                                        <option value="0">Select Month</option>
                                        <option value="1">January</option>
                                        <option value="2">February</option>
                                        <option value="3">March</option>
                                        <option value="4">April</option>
                                        <option value="5">May</option>
                                        <option value="6">June</option>
                                        <option value="7">July</option>
                                        <option value="8">August</option>
                                        <option value="9">September</option>
                                        <option value="10">October</option>
                                        <option value="11">November</option>
                                        <option value="12">December</option>

                                    </InputSelect>
                                </div>
                                
                                <div class="form-group mt-2">
                                    <InputFile @key="fileInputKey" OnChange="HandleFileSelected" accept=".xlsx" class="form-control" disabled="@isUploading" />
                                    <small class="text-muted d-block mt-1">Excel workbook (.xlsx) in the template format, max @(PayrollExcel.MaxFileSize / 1024 / 1024) MB.</small>
                                </div>

                                @if (uploadErrors.Any())
                                {
                                    <div class="upload-errors" role="alert" aria-live="assertive">
                                        <div class="upload-errors__head">
                                            <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
                                            <div>
                                                <strong>The sheet was not uploaded</strong>
                                                <span>@(uploadErrors.Count == 1 ? "Please fix this problem and upload again." : $"Please fix these {uploadErrors.Count} problems and upload again.")</span>
                                            </div>
                                        </div>
                                        <ul class="upload-errors__list">
                                            @foreach (var error in uploadErrors)
                                            {
                                                <li>
                                                    @if (error.Row != null || error.Column != null)
                                                    {
                                                        <span class="upload-errors__where">@error.Location</span>
                                                    }
                                                    <span>@error.Message</span>
                                                    @if (!string.IsNullOrEmpty(error.Value))
                                                    {
                                                        <span class="upload-errors__value">Found: “@error.Value”</span>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="DownloadTemplate">
                                            <i class="fas fa-download me-1" aria-hidden="true"></i>Download the correct template
                                        </button>
                                    </div>
                                }
                            }
                            <div class="float-right mt-2">
                                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal" disabled="@isUploading">Close</button>
                                <button class="btn btn-success btn-sm" type="submit" disabled="@isUploading">
                                    @if (isUploading)
                                    {
                                        <span class="btn-spinner" aria-hidden="true"></span><span>Checking sheet…</span>
                                    }
                                    else
                                    {
                                        <span>Upload</span>
                                    }
                                </button>
                            </div>
                            <YearMonthDialog Visible="showYearMonthExistDialog" Year="filess.Year" Month="filess.Month" OnClose="OnYearMonthDialogClose"></YearMonthDialog>
                            <ConfirmationDialog Visible="showReplaceConfirmationDialog" RecordCount="existingRecordCount" OnClose="OnReplaceDialogClose" />

                        </EditForm>
                    </div>


                </div>
            </div>
        </div>
        <div class="mt-2" style="border-radius:15px;

    -webkit-box-shadow: 1px -15px 22px 0px rgba(0,0,0,0.75);
  -moz-box-shadow: 1px -15px 22px 0px rgba(0,0,0,0.75);
   box-shadow: 1px -15px 22px 0px rgba(0,0,0,0.10);">
            <div style="overflow-x:hidden;">
                @if (!string.IsNullOrEmpty(emailStatusMessage))
                {
                    <div class="alert alert-success" role="alert">
                        @emailStatusMessage
                    </div>
                }
                @if (filteredFileContent != null && filteredFileContent.Any())
                {
                    <table class="table table-hover table-striped">
                        <thead>
                            <tr class="bg-success text-white">
                                <th>Name</th>
                                <th>Designation</th>
                                <th>Cnic</th>
                                <th>Email</th>
                                <th>Year</th>
                                <th>Month</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in filteredFileContent)
                            {
                                <tr class="tr1">
                                    <td>@line.EmployeeName</td>
                                    <td>@line.ServiceCategory</td>
                                    <td>@line.Cnic</td>
                                    <td>@line.Email</td>
                                    <td>@line.Year</td>
                                    <td>@line.Month</td>
                                    <td>
                                        <i class="i1 fas fa-eye pt-1" @onclick="() => ShowDetails(line)" title="View" data-toggle="modal" data-target="#modal-lg"></i>
                                        <i class="i1 fas fa-edit pt-1" @onclick="() => UpdateRecord(line.Id)" title="View" data-toggle="modal" data-target="#myModal"></i>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <Pagination TotaPagesQuantity="Epagination.TotalPages" TotalCount="@totalcount" CurrentPage="Epagination.currentPage" Radius="2"
                                SelectedPage="SelectedPage" ShowrecordTable="@dTO.QuantityPerPage"></Pagination>
                }
                else if (fileContent == null)
                {
                    <p>No data loaded. Please upload a file.</p>
                }
                else if (!fileContent.Any())
                {
                    <p>The uploaded file is empty or invalid format.</p>
                }
            </div>
        </div>
    </div>
</div>
<InputModal Heading="View Details"
            ShowModal="@(selectedRecord != null?true:false)">
    @if (selectedRecord != null)
    {
        <div class="modal-body">

            <div class="row color-odd">

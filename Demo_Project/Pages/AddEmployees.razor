                    <div class="form-group">
                        <p>@(selectedRecord.GrossSalary == 0 ? "-" : selectedRecord.GrossSalary?.ToString("N0"))</p>
                    </div>
                </div>
            </div>
            <div class="row color-even">
                <div class="col-3">
                    <div class="form-group">
                        <p><strong>Advance Loan Deduction</strong></p>

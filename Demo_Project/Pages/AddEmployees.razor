                        <p>@(selectedRecord.OtherDeduction == 0 ? "-" : selectedRecord.OtherDeduction?.ToString("N0"))</p>
                    </div>
                </div>
                <div class="col-3">
                    <div class="form-group">
                        <p><strong>WHIT Deduction</strong></p>
                    </div>
                </div>
                <div class="col-3">
                    <div class="form-group">
                        <p>@(selectedRecord.WHITDeduction == 0 ? "-" : selectedRecord.WHITDeduction?.ToString("N0"))</p>

                    <div class="form-group">
                        <p>@(selectedRecord.AdvancesLoanDeduction == 0 ? "-" : selectedRecord.AdvancesLoanDeduction?.ToString("N0"))</p>
                    </div>
                </div>
                <div class="col-3">
                    <div class="form-group">
                        <p><strong>EOBI</strong></p>
